FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends clang llvm libclang-rt-18-dev cmake ninja-build gcc gcc-multilib g++-multilib libc6-dev libc6-dev-i386 && rm -rf /var/lib/apt/lists/*
WORKDIR /w
